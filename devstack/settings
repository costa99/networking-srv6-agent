# networking-srv6-agent devstack settings. See plugin.sh.

NETWORKING_SRV6_AGENT_DIR=${NETWORKING_SRV6_AGENT_DIR:-$DEST/networking-srv6-agent}

# This node's SRv6 locator. REQUIRED on every node running q-agt, and
# unique per node: a shared locator means two nodes answer for the same
# SIDs. The testbed uses fc00:0:1::/48 (node 1) and fc00:0:2::/48 (node 2).
SRV6_LOCATOR=${SRV6_LOCATOR:-}

# The NIC holding this node's IPv6 underlay: the nexthop device of every
# encap route, and where seg6_enabled is asserted. Optional: unset, the
# agent finds it from the route to each other node's locator.
SRV6_UNDERLAY_INTERFACE=${SRV6_UNDERLAY_INTERFACE:-}

# Server side.
# The microSID Local ID Block, valid under both encodings. A custom range
# must stay inside it with usid; the server refuses to start otherwise.
SRV6_FUNCTION_ID_RANGES=${SRV6_FUNCTION_ID_RANGES:-0xe000:0xefff}
# encap (full SIDs) or usid (RFC 9800 microSID, USID-PLAN.md).
SRV6_DATAPLANE_ENCODING=${SRV6_DATAPLANE_ENCODING:-encap}

# EVERY node: the agent derives a domain's table from the same base as the
# server. A compute-only node that lacked it would silently use the default
# and disagree with the server the day the default was changed.
SRV6_VRF_TABLE_BASE=${SRV6_VRF_TABLE_BASE:-10000}

SRV6_RESYNC_INTERVAL=${SRV6_RESYNC_INTERVAL:-300}

# The Horizon panels (srv6_dashboard): the enabled files plugin.sh copies into
# Horizon when the horizon service is enabled. The SRv6 panels, plus
# _1420_project_network_topology_panel.py, which replaces Horizon's Network
# Topology panel by sharing its file name (FEATURE-HORIZON-DASHBOARD D24).
SRV6_DASHBOARD_ENABLE=${SRV6_DASHBOARD_ENABLE:-$NETWORKING_SRV6_AGENT_DIR/srv6_dashboard/enabled/_[0-9]*_srv6_*panel.py $NETWORKING_SRV6_AGENT_DIR/srv6_dashboard/enabled/_1420_project_network_topology_panel.py}
